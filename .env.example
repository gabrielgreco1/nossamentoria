# URL HTTPS exibida em Project Settings > API no Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon/publishable). Pode ser usada pelo navegador e continua limitada por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo exclusivo do servidor. Nunca use o prefixo NEXT_PUBLIC_ nem exponha em logs.
SUPABASE_SERVICE_ROLE_KEY=

# Origem completa, sem barra final. Local: http://localhost:3000. Produção: HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
